{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "title": "PlanCritique",
  "type": "object",
  "required": ["plan_version", "summary", "issues"],
  "additionalProperties": false,
  "properties": {
    "plan_version": {
      "type": "integer",
      "minimum": 0,
      "description": "Plan version the critique targets (vN from the plan.vN.md filename)."
    },
    "summary": {
      "type": "string",
      "maxLength": 700,
      "description": "Brief overall verdict on the plan. Target ~2–3 sentences and at most ~500 characters; 700 is a hard cap with headroom, not a goal. Do not enumerate issues."
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["considered_context", "invariant_assessments", "scope_coverage", "issue_budget", "scan_complete", "unresolved_coverage"],
      "properties": {
        "considered_context": {
          "type": "array",
          "description": "The six mandatory retained categories assessed for this exact plan version. The vocabulary is closed; an unavailable/empty category is still considered when its explicit marker was assessed.",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "enum": [
              "original-scope",
              "authoritative-system-facts",
              "operator-decisions",
              "material-findings",
              "active-invariants",
              "quality-and-limits"
            ]
          }
        },
        "invariant_assessments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["invariant_id", "complete", "occurrences"],
            "properties": {
              "invariant_id": { "type": "string" },
              "complete": { "type": "boolean" },
              "occurrences": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["occurrence_id", "disposition", "evidence_refs"],
                  "properties": {
                    "occurrence_id": { "type": "string" },
                    "disposition": { "enum": ["satisfied", "violated", "not-applicable", "unresolved"] },
                    "evidence_refs": { "$ref": "#/$defs/evidenceRefs" }
                  }
                }
              }
            }
          }
        },
        "scope_coverage": {
          "type": "array",
          "description": "Scope categories actually checked: original-scope for the original prompt, direct-plan-scope for a self-contained direct plan, or declared-scope as the compatibility token for separately declared scope. Omit an unproved category and report it as unresolved.",
          "uniqueItems": true,
          "items": {
            "enum": ["original-scope", "declared-scope", "direct-plan-scope"]
          }
        },
        "issue_budget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["limit", "used", "exhausted"],
          "properties": {
            "limit": { "type": "integer", "minimum": 1 },
            "used": { "type": "integer", "minimum": 0 },
            "exhausted": { "type": "boolean" }
          }
        },
        "scan_complete": { "type": "boolean" },
        "unresolved_coverage": { "type": "array", "items": { "type": "string" } }
      }
    },
    "domain_assessments": {
      "type": "array",
      "description": "Assessment of the fixed readiness domains for this exact plan version. Emit one entry per domain; an empty array is accepted only as a compatibility input and cannot prove readiness.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "domain",
          "applicability",
          "risk",
          "complete",
          "rationale",
          "unavailable_evidence",
          "evidence_refs"
        ],
        "properties": {
          "domain": { "$ref": "#/$defs/riskDomain" },
          "applicability": { "$ref": "#/$defs/applicability" },
          "risk": { "$ref": "#/$defs/riskLevel" },
          "complete": {
            "type": "boolean",
            "description": "True only when the applicable evidence needed to assess this domain was available and checked for this plan version."
          },
          "rationale": {
            "type": "string",
            "description": "Concise evidence-based explanation of applicability, risk, and any unavailable required evidence."
          },
          "unavailable_evidence": {
            "type": "array",
            "description": "Required evidence that could not be obtained. Keep empty when the assessment is complete or the domain is not applicable.",
            "items": { "type": "string" }
          },
          "evidence_refs": { "$ref": "#/$defs/evidenceRefs" }
        }
      }
    },
    "boundary_challenges": {
      "type": "array",
      "description": "Material changes that would alter the frozen implementation boundary or exceed its assurance appetite. Any entry prevents an in-run revision decision.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "claim", "rationale", "evidence", "evidence_refs"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^B[0-9]+$"
          },
          "kind": {
            "enum": ["scope-expansion", "out-of-scope-removal", "assurance-appetite"]
          },
          "claim": {
            "type": "string",
            "description": "The concrete boundary or appetite change required before readiness can be decided."
          },
          "rationale": {
            "type": "string",
            "description": "Why the frozen contract cannot contain the required change."
          },
          "evidence": {
            "type": "string",
            "description": "A quote from the frozen contract or plan, or a path:line reference."
          },
          "evidence_refs": { "$ref": "#/$defs/evidenceRefs" }
        }
      }
    },
    "opportunities": {
      "type": "array",
      "description": "Non-blocking improvements that remain visible but never trigger a creator revision or affect readiness.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fingerprint", "claim", "evidence", "suggested_improvement", "evidence_refs"],
        "properties": {
          "fingerprint": {
            "type": "string",
            "minLength": 1,
            "description": "Stable identity derived from the substantive claim, evidence, and improvement rather than the plan version."
          },
          "claim": {
            "type": "string",
            "description": "One-sentence optional improvement."
          },
          "evidence": {
            "type": "string",
            "description": "A quote from the plan or a path:line reference."
          },
          "suggested_improvement": {
            "type": "string",
            "description": "A concrete non-blocking improvement."
          },
          "evidence_refs": { "$ref": "#/$defs/evidenceRefs" }
        }
      }
    },
    "issues": {
      "type": "array",
      "description": "Material blocker or major issues that are fixable inside the frozen boundary. Optional improvements belong in opportunities. An empty array means no in-boundary revision is required.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "addresses",
          "severity",
          "category",
          "claim",
          "evidence",
          "suggested_fix",
          "confidence",
          "duplicate_of"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^C[0-9]+$",
            "description": "Issue identifier within this iteration: C1, C2, ..."
          },
          "addresses": {
            "type": ["string", "null"],
            "pattern": "^v[0-9]+\\.C[0-9]+$",
            "description": "ID of the immediate parent issue from a previous iteration that this issue refines. Use the most recent iteration covering this concern, for example v2.C1. Null if new."
          },
          "severity": {
            "enum": ["blocker", "major"],
            "description": "blocker — the plan cannot be executed as is; major — a serious gap required for correct execution."
          },
          "category": {
            "enum": [
              "correctness",
              "scope",
              "risk",
              "testability",
              "clarity",
              "convention",
              "missing_context",
              "assumption"
            ]
          },
          "claim": {
            "type": "string",
            "description": "The critic's concrete claim. One sentence."
          },
          "evidence": {
            "type": "string",
            "description": "A quote from the plan or a path:line reference. Without evidence the issue is dropped by the validator as a hallucination."
          },
          "evidence_refs": { "$ref": "#/$defs/evidenceRefs" },
          "invariant_id": { "type": ["string", "null"] },
          "introduced_by_revision": {
            "type": ["string", "null"],
            "pattern": "^plan\\.v[0-9]+\\.md$"
          },
          "suggested_fix": {
            "type": "string",
            "description": "What exactly to change in the plan. An action, not a wish."
          },
          "confidence": {
            "type": ["number", "null"],
            "minimum": 0,
            "maximum": 1,
            "description": "Critic confidence 0..1 or null. <0.5 — the judge may reject even plausible-looking issues."
          },
          "duplicate_of": {
            "type": ["string", "null"],
            "description": "Compatibility lineage field. Material issues must use null; a rejected repeat belongs in opportunities instead."
          }
        }
      }
    }
  },
  "$defs": {
    "riskDomain": {
      "enum": [
        "correctness",
        "public-compatibility",
        "data-migrations",
        "security-privacy-authorization",
        "concurrency-distributed-ordering",
        "cross-repository-delivery",
        "production-operability",
        "performance-cost"
      ]
    },
    "applicability": {
      "enum": ["applicable", "not-applicable", "unknown"]
    },
    "riskLevel": {
      "enum": ["standard", "high"]
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind"],
        "properties": {
          "kind": { "enum": ["file-line", "plan-section", "phase-gate", "command", "repository", "topology"] },
          "value": { "type": "string" },
          "path": { "type": "string" },
          "line": { "type": "integer", "minimum": 1 },
          "section": { "type": "string" },
          "phase": { "type": "string" },
          "gate": { "type": "string" },
          "command": { "type": "string" },
          "repository": { "type": "string" },
          "topology_id": { "type": "string" }
        }
      }
    }
  }
}
