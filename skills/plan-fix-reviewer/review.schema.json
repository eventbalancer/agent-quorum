{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "title": "PlanFixReview",
  "type": "object",
  "required": [
    "approval",
    "coverage_complete",
    "unresolved_occurrence_ids",
    "invariant_assessments",
    "concerns"
  ],
  "additionalProperties": false,
  "properties": {
    "approval": {
      "type": "string",
      "enum": ["accept", "accept_with_concerns", "reject"],
      "description": "accept — 0 concerns or nit only; accept_with_concerns — there are minor concerns; reject — there are blocker/major concerns."
    },
    "coverage_complete": {
      "type": "boolean",
      "description": "True exactly when every active invariant and every retained occurrence is represented exactly once. Explicit unresolved dispositions count as represented."
    },
    "unresolved_occurrence_ids": {
      "type": "array",
      "description": "Exactly the occurrence ids whose disposition is unresolved, with no omissions or additions.",
      "items": { "type": "string", "minLength": 1 }
    },
    "invariant_assessments": {
      "type": "array",
      "description": "Exactly one assessment for every active invariant.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["invariant_id", "occurrences"],
        "properties": {
          "invariant_id": { "type": "string", "minLength": 1 },
          "occurrences": {
            "type": "array",
            "description": "Exactly one entry for every retained occurrence of this invariant.",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["occurrence_id", "disposition", "evidence_refs"],
              "properties": {
                "occurrence_id": { "type": "string", "minLength": 1 },
                "disposition": {
                  "enum": ["satisfied", "violated", "not-applicable", "unresolved"],
                  "description": "satisfied, violated, and not-applicable require grounded evidence for the current candidate; unresolved is explicit when no grounded conclusion is available."
                },
                "evidence_refs": { "$ref": "#/$defs/evidenceRefs" }
              }
            }
          }
        }
      }
    },
    "concerns": {
      "type": "array",
      "description": "List of concerns about the proposed fix. Each concern is tied to a specific spot in the Proposed fix or to an unresolved finding.",
      "items": {
        "type": "object",
        "required": ["id", "claim", "evidence", "severity"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^R[0-9]+$",
            "description": "Unique concern identifier, R1, R2, ..."
          },
          "claim": {
            "type": "string",
            "description": "One phrase describing the problem."
          },
          "evidence": {
            "type": "string",
            "description": "A concrete anchor: file:line from the Proposed fix, a verbatim quote, or the id of a Findings entry that remains unresolved."
          },
          "severity": {
            "type": "string",
            "enum": ["blocker", "major", "minor", "nit"]
          }
        }
      }
    }
  },
  "$defs": {
    "evidenceRefs": {
      "type": "array",
      "description": "Grounded references supporting this occurrence disposition. It may be empty only for an unresolved disposition.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind"],
        "properties": {
          "kind": {
            "enum": [
              "file-line",
              "plan-section",
              "phase-gate",
              "command",
              "repository",
              "topology"
            ]
          },
          "value": { "type": "string" },
          "path": { "type": "string" },
          "line": { "type": "integer", "minimum": 1 },
          "section": { "type": "string" },
          "phase": { "type": "string" },
          "gate": { "type": "string" },
          "command": { "type": "string" },
          "repository": { "type": "string" },
          "topology_id": { "type": "string" }
        }
      }
    }
  }
}
