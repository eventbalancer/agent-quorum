{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "title": "PlanReadiness",
  "type": "object",
  "required": ["ready", "rationale"],
  "additionalProperties": false,
  "properties": {
    "ready": {
      "type": "boolean"
    },
    "rationale": {
      "type": "string",
      "maxLength": 700
    },
    "revision_issue": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["severity", "category", "claim", "evidence", "evidence_refs", "suggested_fix"],
      "properties": {
        "severity": { "enum": ["blocker", "major"] },
        "category": {
          "enum": [
            "correctness",
            "scope",
            "risk",
            "testability",
            "clarity",
            "convention",
            "missing_context",
            "assumption"
          ]
        },
        "claim": { "type": "string", "minLength": 1 },
        "evidence": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind"],
            "properties": {
              "kind": {
                "enum": [
                  "file-line",
                  "plan-section",
                  "phase-gate",
                  "command",
                  "repository",
                  "topology"
                ]
              },
              "value": { "type": "string" },
              "path": { "type": "string" },
              "line": { "type": "integer", "minimum": 1 },
              "section": { "type": "string" },
              "phase": { "type": "string" },
              "gate": { "type": "string" },
              "command": { "type": "string" },
              "repository": { "type": "string" },
              "topology_id": { "type": "string" }
            }
          }
        },
        "suggested_fix": { "type": "string", "minLength": 1 }
      }
    },
    "coverage_complete": { "type": "boolean" },
    "unresolved_occurrence_ids": { "type": "array", "items": { "type": "string" } },
    "invariant_assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["invariant_id", "satisfied", "unresolved_occurrence_ids"],
        "properties": {
          "invariant_id": { "type": "string" },
          "satisfied": { "type": "boolean" },
          "unresolved_occurrence_ids": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
