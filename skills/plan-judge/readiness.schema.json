{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "title": "PlanReadiness",
  "type": "object",
  "required": ["ready", "rationale"],
  "additionalProperties": false,
  "properties": {
    "ready": {
      "type": "boolean"
    },
    "rationale": {
      "type": "string",
      "maxLength": 700
    },
    "coverage_complete": { "type": "boolean" },
    "unresolved_occurrence_ids": { "type": "array", "items": { "type": "string" } },
    "invariant_assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["invariant_id", "satisfied", "unresolved_occurrence_ids"],
        "properties": {
          "invariant_id": { "type": "string" },
          "satisfied": { "type": "boolean" },
          "unresolved_occurrence_ids": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
