{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "title": "PlanUpdateMeta",
  "type": "object",
  "required": [
    "plan_version",
    "issues",
    "applied",
    "systemic_dispositions",
    "rejected_append"
  ],
  "additionalProperties": false,
  "properties": {
    "plan_version": {
      "type": "integer",
      "minimum": 1,
      "description": "Version after revision (input.plan_version + 1)."
    },
    "issues": {
      "type": "array",
      "description": "Each original critique issue receives a verdict. Preserve order and ids.",
      "items": {
        "type": "object",
        "required": ["id", "verdict", "verdict_reason", "final_severity", "duplicate_of"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^C[0-9]+$"
          },
          "verdict": {
            "enum": [
              "accept",
              "reject_hallucinated",
              "reject_out_of_scope",
              "reject_taste",
              "downgrade"
            ]
          },
          "verdict_reason": {
            "type": "string",
            "minLength": 1
          },
          "final_severity": {
            "enum": ["blocker", "major", "minor", "nit"]
          },
          "duplicate_of": {
            "type": "null"
          }
        }
      }
    },
    "applied": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^C[0-9]+$"
      }
    },
    "systemic_dispositions": {
      "description": "Exactly one grounded disposition for every accepted or downgraded blocker/major issue. Use an empty array when no such material issue was accepted or downgraded.",
      "$ref": "#/$defs/systemicDispositions"
    },
    "rejected_append": {
      "type": "array",
      "maxItems": 0,
      "description": "Must be empty because current critic output contains only material issues."
    }
  },
  "$defs": {
    "systemicDispositions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["issue_id", "scope", "rationale", "evidence_refs", "invariant"],
        "properties": {
          "issue_id": { "type": "string", "pattern": "^C[0-9]+$" },
          "scope": { "enum": ["local", "cross-cutting"] },
          "rationale": { "type": "string", "minLength": 1 },
          "evidence_refs": { "$ref": "#/$defs/evidenceRefs" },
          "superseded_by": { "type": ["string", "null"] },
          "invariant": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["statement", "occurrences"],
            "properties": {
              "statement": { "type": "string", "minLength": 1 },
              "occurrences": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["dimension", "subject"],
                  "properties": {
                    "dimension": { "type": "string", "minLength": 1 },
                    "subject": { "type": "string", "minLength": 1 }
                  }
                }
              }
            }
          }
        }
      }
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind"],
        "properties": {
          "kind": { "enum": ["file-line", "plan-section", "phase-gate", "command", "repository", "topology"] },
          "value": { "type": "string" },
          "path": { "type": "string" },
          "line": { "type": "integer", "minimum": 1 },
          "section": { "type": "string" },
          "phase": { "type": "string" },
          "gate": { "type": "string" },
          "command": { "type": "string" },
          "repository": { "type": "string" },
          "topology_id": { "type": "string" }
        }
      }
    }
  }
}
