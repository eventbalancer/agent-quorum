#!/usr/bin/env bash
json_encode() {
  node -e 'let d="";process.stdin.on("data",c=>{d+=c}).on("end",()=>{process.stdout.write(JSON.stringify(d))})'
}
if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  cat <<'HELP'
  --trust                      Trust the current workspace without prompting
  --approve-mcps               Automatically approve all MCP servers
  --model <model>              Model to use
  --workspace <path>           Workspace directory
HELP
  exit 0
fi
if [[ "${1:-}" == "status" ]]; then
  exit "${FAKE_CURSOR_STATUS:-0}"
fi
is_json=0
is_resume=0
args=("$@")
for arg in "${args[@]}"; do
  [[ "$arg" == "--resume" ]] && is_resume=1
done
if [[ -n "${FAKE_CURSOR_ARGS_LOG:-}" ]]; then
  printf '%s\n' "$*" >> "$FAKE_CURSOR_ARGS_LOG"
fi
if [[ -n "${FAKE_CURSOR_ARGV_LOG:-}" ]]; then
  { for arg in "$@"; do printf '%s\0' "$arg"; done; printf '\036'; } >> "$FAKE_CURSOR_ARGV_LOG"
fi
prompt="$(cat)"
if [[ -n "${FAKE_CURSOR_PROMPT:-}" ]]; then
  printf '%s' "$prompt" > "$FAKE_CURSOR_PROMPT"
fi
# Raw-stderr injection: a multi-line blob plus one ~2 MB line with no trailing
# newline, then a non-zero exit. Exercises bounded capture + default-drop.
if [[ -n "${FAKE_CURSOR_STDERR:-}" ]]; then
  printf 'raw cursor stderr alpha: %s\n' "$FAKE_CURSOR_STDERR" >&2
  printf 'raw cursor stderr beta: overloaded request\n' >&2
  head -c 2000000 /dev/zero | tr '\0' 'x' >&2
  exit "${FAKE_CURSOR_STDERR_EXIT:-1}"
fi
if [[ "$prompt" == *"## JSON schema"* ]]; then
  is_json=1
fi
if [[ -n "${FAKE_CURSOR_ATTEMPTS:-}" ]]; then
  attempts=0
  [[ -f "$FAKE_CURSOR_ATTEMPTS" ]] && attempts="$(cat "$FAKE_CURSOR_ATTEMPTS")"
  attempts=$((attempts + 1))
  printf '%s' "$attempts" > "$FAKE_CURSOR_ATTEMPTS"
  if (( attempts <= ${FAKE_CURSOR_FAILS:-0} )); then
    printf '{"type":"result","subtype":"error","is_error":true,"result":"cursor transient failure"}\n' >&2
    exit 1
  fi
fi
if (( is_resume == 1 )) && [[ -n "${FAKE_CURSOR_FAIL_ON_RESUME:-}" ]]; then
  printf '{"type":"result","subtype":"error","is_error":true,"result":"resume failed"}\n'
  exit 1
fi
session_id="${FAKE_CURSOR_SESSION_ID:-cursor-session-fixture}"
if (( is_json == 1 )) && [[ "$prompt" == *$'\nstage: assessment\n'* ]]; then
  if [[ -n "${FAKE_READINESS_ASSESSMENT:-}" ]]; then
    result="$(cat "$FAKE_READINESS_ASSESSMENT")"
  else
    result='{"boundary":{"goal":"Produce the fixture implementation plan.","in_scope":["fixture implementation"],"out_of_scope":["unrelated fixture behavior"],"constraints":["preserve fixture contracts"]},"domain_assessments":[{"domain":"correctness","applicability":"applicable","risk":"standard","rationale":"Fixture correctness assessment.","evidence_refs":[]},{"domain":"public-compatibility","applicability":"not-applicable","risk":"standard","rationale":"Fixture compatibility assessment.","evidence_refs":[]},{"domain":"data-migrations","applicability":"not-applicable","risk":"standard","rationale":"Fixture migration assessment.","evidence_refs":[]},{"domain":"security-privacy-authorization","applicability":"not-applicable","risk":"standard","rationale":"Fixture security assessment.","evidence_refs":[]},{"domain":"concurrency-distributed-ordering","applicability":"not-applicable","risk":"standard","rationale":"Fixture concurrency assessment.","evidence_refs":[]},{"domain":"cross-repository-delivery","applicability":"not-applicable","risk":"standard","rationale":"Fixture delivery assessment.","evidence_refs":[]},{"domain":"production-operability","applicability":"not-applicable","risk":"standard","rationale":"Fixture operability assessment.","evidence_refs":[]},{"domain":"performance-cost","applicability":"not-applicable","risk":"standard","rationale":"Fixture performance assessment.","evidence_refs":[]}],"material_questions":[]}'
  fi
elif (( is_json == 1 )); then
  result_file="${FAKE_CURSOR_JSON_RESULT:-}"
  if [[ -n "${FAKE_CURSOR_JSON_CALLS:-}" ]]; then
    calls=0
    [[ -f "$FAKE_CURSOR_JSON_CALLS" ]] && calls="$(cat "$FAKE_CURSOR_JSON_CALLS")"
    calls=$((calls + 1))
    printf '%s' "$calls" > "$FAKE_CURSOR_JSON_CALLS"
    var="FAKE_CURSOR_JSON_RESULT_$calls"
    result_file="${!var:-$result_file}"
  fi
  [[ -n "$result_file" ]] || { echo "fake cursor-agent: missing FAKE_CURSOR_JSON_RESULT" >&2; exit 2; }
else
  result_file="${FAKE_CURSOR_MARKDOWN_RESULT:-}"
  if [[ -n "${FAKE_CURSOR_MARKDOWN_CALLS:-}" ]]; then
    calls=0
    [[ -f "$FAKE_CURSOR_MARKDOWN_CALLS" ]] && calls="$(cat "$FAKE_CURSOR_MARKDOWN_CALLS")"
    calls=$((calls + 1))
    printf '%s' "$calls" > "$FAKE_CURSOR_MARKDOWN_CALLS"
    var="FAKE_CURSOR_MARKDOWN_RESULT_$calls"
    result_file="${!var:-$result_file}"
  fi
  [[ -n "$result_file" ]] || { echo "fake cursor-agent: missing FAKE_CURSOR_MARKDOWN_RESULT" >&2; exit 2; }
fi
if [[ -z "${result:-}" ]]; then
  result="$(cat "$result_file")"
fi
# Liveness injection: stay alive and silent (no stdout) for the requested
# seconds so the wall-clock heartbeat fires and the byte-idle watchdog can still
# trigger, then emit the normal success result if not killed first.
if [[ -n "${FAKE_CURSOR_SILENT_SECONDS:-}" ]]; then
  sleep "$FAKE_CURSOR_SILENT_SECONDS"
fi
printf '{"type":"system","subtype":"init","session_id":"%s","model":"composer-2.5"}\n' "$session_id"
printf '{"type":"result","subtype":"success","is_error":false,"result":%s,"session_id":"%s"}\n' \
  "$(printf '%s' "$result" | json_encode)" "$session_id"
